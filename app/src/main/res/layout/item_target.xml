<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_node_card"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/ipText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#38bdf8"
            android:textSize="18sp"
            android:textStyle="bold"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />

        <Button
            android:id="@+id/editBtn"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingHorizontal="8dp"
            android:layout_marginEnd="6dp"
            android:backgroundTint="#1e293b"
            android:text="EDIT"
            android:textColor="#94a3b8"
            android:textSize="10sp" />

        <Button
            android:id="@+id/shareBtn"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingHorizontal="8dp"
            android:layout_marginEnd="6dp"
            android:backgroundTint="#1e293b"
            android:text="SHARE"
            android:textColor="#94a3b8"
            android:textSize="10sp" />

        <Button
            android:id="@+id/deleteBtn"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingHorizontal="8dp"
            android:backgroundTint="#7f1d1d"
            android:text="DEL"
            android:textColor="#fca5a5"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/metaText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="monospace"
        android:textColor="#e2e8f0"
        android:textSize="13sp"
        android:lineSpacingExtra="4dp"
        android:textIsSelectable="true" />

    <TextView
        android:id="@+id/walletsText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="monospace"
        android:textColor="#4ade80"
        android:textSize="13sp"
        android:lineSpacingExtra="4dp"
        android:textIsSelectable="true"
        android:visibility="gone" />

    <TextView
        android:id="@+id/softwareText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="monospace"
        android:textColor="#38bdf8"
        android:textSize="13sp"
        android:lineSpacingExtra="4dp"
        android:textIsSelectable="true"
        android:visibility="gone" />

    <TextView
        android:id="@+id/validatedText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#64748b"
        android:textSize="10sp"
        android:textStyle="italic" />

</LinearLayout>